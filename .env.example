# Example configuration. Copy to .env and adjust.
# Placeholders only — never commit real credentials.

# --- service ---
LEDGER_SERVICE_NAME=ledger-api
LEDGER_LOG_LEVEL=info
LEDGER_HTTP_ADDR=:8080
LEDGER_METRICS_ADDR=:8081

# --- postgresql (authoritative store) ---
LEDGER_DATABASE_URL=postgres://REPLACE_USER:REPLACE_PASSWORD@localhost:5432/ledger?sslmode=disable
LEDGER_DB_MAX_CONNS=20
LEDGER_DB_MIN_CONNS=2
# Bounding lock waits is what turns a potential deadlock into a retryable error.
LEDGER_DB_LOCK_TIMEOUT=3s
LEDGER_DB_STATEMENT_TIMEOUT=10s
LEDGER_DB_MAX_TX_RETRIES=5

# --- redis (optional cache; never authoritative) ---
LEDGER_REDIS_ENABLED=true
LEDGER_REDIS_ADDR=localhost:6379
LEDGER_REDIS_PASSWORD=
LEDGER_REDIS_DB=0
LEDGER_REDIS_TIMEOUT=150ms
LEDGER_IDEMPOTENCY_CACHE_TTL=24h

# --- rate limiting (availability control, fails open) ---
LEDGER_RATE_LIMIT_ENABLED=true
LEDGER_RATE_LIMIT_RPS=200
LEDGER_RATE_LIMIT_BURST=400

# --- kafka (at-least-once delivery) ---
LEDGER_KAFKA_ENABLED=true
LEDGER_KAFKA_BROKERS=localhost:9092
LEDGER_KAFKA_CLIENT_ID=ledger
LEDGER_KAFKA_TIMEOUT=5s
LEDGER_TOPIC_PAYMENTS_CREATED=payments.created
LEDGER_TOPIC_PAYMENTS_REVERSED=payments.reversed
LEDGER_TOPIC_PAYMENTS_FAILED=payments.failed
LEDGER_TOPIC_PAYMENTS_DLQ=payments.dlq

# --- transactional outbox ---
LEDGER_OUTBOX_BATCH_SIZE=100
LEDGER_OUTBOX_POLL_INTERVAL=500ms
LEDGER_OUTBOX_MAX_ATTEMPTS=8
LEDGER_OUTBOX_BASE_BACKOFF=250ms
LEDGER_OUTBOX_MAX_BACKOFF=60s
LEDGER_OUTBOX_CLAIM_TTL=30s
# Defaults to hostname-pid; set explicitly only if you need stable worker IDs.
LEDGER_OUTBOX_WORKER_ID=

# --- webhooks ---
LEDGER_WEBHOOK_ENDPOINTS=http://localhost:9090/webhook
LEDGER_WEBHOOK_CONSUMER_GROUP=webhook-worker
LEDGER_WEBHOOK_MAX_ATTEMPTS=5
LEDGER_WEBHOOK_BASE_BACKOFF=500ms
LEDGER_WEBHOOK_MAX_BACKOFF=5m
LEDGER_WEBHOOK_TIMEOUT=5s
LEDGER_WEBHOOK_POLL_INTERVAL=500ms
LEDGER_WEBHOOK_BATCH_SIZE=50
LEDGER_WEBHOOK_SIGNING_SECRET=REPLACE_WITH_RANDOM_SECRET

# --- failure injection (tests only; must be false in production) ---
LEDGER_FAILPOINTS_ENABLED=false
# e.g. before_commit=error,after_commit=error:1,before_kafka_publish=sleep:250ms
LEDGER_FAILPOINTS=
